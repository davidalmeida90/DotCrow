[Desktop Entry]
Type=Application
Name=DotCrow
GenericName=Agentes no seu computador
Comment=Abre o painel do DotCrow (chaves de API, tarefas e os corvos)
# Caminho fixo: um dotcrow antigo em ~/.local/bin não pode passar na frente do instalado pelo .deb.
# O instalar.sh troca esta linha pelo caminho onde ele instalou o comando.
Exec=/usr/bin/dotcrow
Terminal=false
StartupWMClass=DotCrow
Icon=dotcrow
Categories=Utility;Development;
Keywords=IA;agentes;LLM;corvos;painel;
